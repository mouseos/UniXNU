+/* Optional profiling of the eager native4k preparation only. No I/O, clock,
+ * formatting or UART occurs in VM fault validation. Values are per-call until
+ * final aggregation; all timestamps are disjoint read/original/derived SHA. */
+#include <pexpert/pexpert.h>
+#if defined(XNU_ROOT_TIMING) && XNU_ROOT_TIMING
+extern void native_root_hash_timing_record(int, uint64_t, const uint64_t [5], int);
+struct native_cs_io_timing { int enabled, pid; uint64_t uid, metrics[5]; };
+static struct native_cs_io_timing
+native_cs_io_begin(void)
+{
+	struct native_cs_io_timing t = {0}; unsigned flag = 0;
+	if (!PE_parse_boot_argn("native-root-timing", &flag, sizeof(flag)) || flag != 1) return t;
+	proc_t p = current_proc(); t.pid = proc_getpid(p); t.uid = proc_uniqueid(p);
+	t.enabled = t.pid > 0 && t.uid != 0;
+	return t;
+}
+static uint64_t
+native_cs_io_start(const struct native_cs_io_timing *t)
+{
+	return t->enabled ? native_blob_now() : 0;
+}
+static void
+native_cs_io_elapsed(struct native_cs_io_timing *t, unsigned phase, uint64_t begin)
+{
+	if (t->enabled) t->metrics[phase] += native_blob_now() - begin;
+}
+static void
+native_cs_io_read(struct native_cs_io_timing *t, uint64_t bytes)
+{
+	if (t->enabled) { t->metrics[3]++; t->metrics[4] += bytes; }
+}
+static void
+native_cs_io_finish(const struct native_cs_io_timing *t, int batched)
+{
+	if (t->enabled) native_root_hash_timing_record(t->pid, t->uid, t->metrics, batched);
+}
+#else
+struct native_cs_io_timing { int unused; };
+#define native_cs_io_begin() ((struct native_cs_io_timing){0})
+#define native_cs_io_start(t) ((void)(t), 0ULL)
+#define native_cs_io_elapsed(t, phase, begin) ((void)(t), (void)(begin))
+#define native_cs_io_read(t, bytes) ((void)(t))
+#define native_cs_io_finish(t, batched) ((void)(t))
+#endif
+
 __attribute__((noinline))
 static int
 cs_native4k_prepare(vnode_t vp, struct cs_blob *blob)
@@ -5856,8 +5901,11 @@
 	uint64_t limit, offset;
 	int error = EBADEXEC;
 	kern_return_t kr;
+	unsigned read_size = 16384, batch_flag = 0;
+	struct native_cs_io_timing io_timing = native_cs_io_begin();
 
 	if (blob->csb_hash_pageshift <= PAGE_SHIFT) {
+		native_cs_io_finish(&io_timing, 0);
 		return 0;
 	}
 	if (PAGE_SHIFT != 12 || blob->csb_hash_pageshift != 14 || cd == NULL || md == NULL ||
@@ -5865,67 +5913,81 @@
 	    md->cs_digest_size > CS_HASH_MAX_SIZE || blob->csb_base_offset < 0 ||
 	    (blob->csb_base_offset & PAGE_MASK) || blob->csb_hash_firstlevel_pageshift ||
 	    ((ntohl(cd->version) >= CS_SUPPORTSSCATTER) && ntohl(cd->scatterOffset))) {
+		native_cs_io_finish(&io_timing, 0);
 		return ENOTSUP;
 	}
 	limit = ntohl(cd->codeLimit);
 	if (!limit || ((ntohl(cd->version) >= CS_SUPPORTSCODELIMIT64) &&
 	    ntohll(cd->codeLimit64) && ntohll(cd->codeLimit64) != limit) ||
 	    ntohl(cd->nCodeSlots) != ((limit + 16383) >> 14)) {
+		native_cs_io_finish(&io_timing, 0);
 		return ENOTSUP;
 	}
 	count = (limit + PAGE_MASK) >> PAGE_SHIFT;
 	if (os_mul_overflow(count, (vm_size_t)md->cs_size, &allocation) ||
 	    round_page_overflow(allocation, &allocation)) {
+		native_cs_io_finish(&io_timing, 0);
 		return EOVERFLOW;
 	}
 	kr = kmem_alloc(kernel_map, &storage, allocation,
 	    KMA_KOBJECT | KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_SECURITY);
 	if (kr != KERN_SUCCESS) {
+		native_cs_io_finish(&io_timing, 0);
 		return ENOMEM;
 	}
-	buffer = kalloc_data(16384, Z_WAITOK);
-	for (offset = 0; offset < limit; offset += 16384) {
