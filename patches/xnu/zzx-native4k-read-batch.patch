-		const uint8_t *expected;
+	if (vnode_vfsisrdonly(vp) && PE_parse_boot_argn("native-cs-read-batch", &batch_flag, sizeof(batch_flag)) && batch_flag == 1) read_size = 256 * 1024;
+	buffer = kalloc_data(read_size, Z_WAITOK);
