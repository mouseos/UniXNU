-		}
-		md->cs_init(&ctx);
-		md->cs_update(&ctx, buffer, length);
-		md->cs_final(digest, &ctx);
-		if (bcmp(expected, digest, md->cs_size)) {
-			os_atomic_inc(&cs_validate_page_bad_hash, relaxed);
-			error = EBADEXEC;
-			goto out;
-		}
-		os_atomic_inc(&cs_native4k_full_blocks, relaxed);
-		for (size_t sub = 0; sub < length; sub += PAGE_SIZE) {
-			size_t bytes = MIN((size_t)PAGE_SIZE, length - sub);
-			vm_size_t index = (offset + sub) >> PAGE_SHIFT;
+		native_cs_io_elapsed(&io_timing, 0, stamp);
+		if (error || resid) { error = error ? error : EIO; goto out; }
+		/* Every original 16KiB signed block is authenticated independently.
+		 * Tail bytes and derived 4KiB digests use only this exact read buffer. */
+		for (size_t block = 0; block < length; block += 16384) {
+			union cs_hash_union ctx;
+			uint8_t digest[CS_HASH_MAX_SIZE];
+			size_t original_bytes = MIN((size_t)16384, length - block);
+			const uint8_t *expected = hashes(cd, (uint32_t)((offset + block) >> 14), md->cs_size, lower, upper);
+			if (expected == NULL) { error = EBADEXEC; goto out; }
+			stamp = native_cs_io_start(&io_timing);
 			md->cs_init(&ctx);
-			md->cs_update(&ctx, buffer + sub, bytes);
+			md->cs_update(&ctx, buffer + block, original_bytes);
 			md->cs_final(digest, &ctx);
-			memcpy((void *)(storage + index * md->cs_size), digest, md->cs_size);
-		}
+			native_cs_io_elapsed(&io_timing, 1, stamp);
+			if (bcmp(expected, digest, md->cs_size)) {
+				os_atomic_inc(&cs_validate_page_bad_hash, relaxed);
+				error = EBADEXEC;
+				goto out;
+			}
+			os_atomic_inc(&cs_native4k_full_blocks, relaxed);
