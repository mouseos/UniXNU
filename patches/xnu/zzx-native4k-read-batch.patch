+		    os_add_overflow(position, (off_t)length - 1, &last)) {
 			error = EOVERFLOW;
 			goto out;
 		}
+		(void)last;
+		native_cs_io_read(&io_timing, length);
+		uint64_t stamp = native_cs_io_start(&io_timing);
 		error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, (int)length, position,
 		    UIO_SYSSPACE, 0, vfs_context_ucred(vfs_context_current()),
 		    &resid, current_proc());
-		if (error || resid) {
-			error = error ? error : EIO;
-			goto out;
-		}
-		expected = hashes(cd, (uint32_t)(offset >> 14), md->cs_size, lower, upper);
-		if (expected == NULL) {
-			error = EBADEXEC;
