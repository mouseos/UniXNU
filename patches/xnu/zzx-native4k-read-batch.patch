+				size_t bytes = MIN((size_t)PAGE_SIZE, original_bytes - sub);
+				vm_size_t index = (offset + block + sub) >> PAGE_SHIFT;
+				stamp = native_cs_io_start(&io_timing);
+				md->cs_init(&ctx);
+				md->cs_update(&ctx, buffer + block + sub, bytes);
+				md->cs_final(digest, &ctx);
+				native_cs_io_elapsed(&io_timing, 2, stamp);
+				memcpy((void *)(storage + index * md->cs_size), digest, md->cs_size);
+			}
+		}
+		offset += length;
 	}
 	kr = vm_map_protect(kernel_map, storage, storage + allocation, VM_PROT_READ, TRUE);
 	if (kr != KERN_SUCCESS) {
@@ -5939,10 +6001,11 @@
 	os_atomic_inc(&cs_native4k_ready_blobs, relaxed);
 	error = 0;
 out:
