+/* Optional disjoint blob-add wall intervals. INIT is exactly the initial
+ * cs_blob_init_validated call; PRE ends immediately before MACF (or POST when
+ * MACF is absent). MAC is exactly the callback; POST includes subsequent work,
+ * vnode lock/wait and original cleanup. No pointer survives as a reference. */
+#if defined(XNU_ROOT_TIMING) && XNU_ROOT_TIMING
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+extern void native_root_blob_timing_record(int, uint64_t, uintptr_t, uint32_t, int64_t,
+    const uint64_t [4], unsigned, int);
+struct native_blob_timing { int enabled, pid; uint64_t uid; uintptr_t address;
+    uint32_t vid; int64_t base; uint64_t stamp, ns[4]; unsigned phase, mac_count; };
+static uint64_t
+native_blob_now(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+static struct native_blob_timing
+native_blob_begin(struct vnode *vp, int64_t base)
+{
+	struct native_blob_timing t = {0};
+	unsigned flag = 0;
+	if (!PE_parse_boot_argn("native-root-timing", &flag, sizeof(flag)) || flag != 1) return t;
+	proc_t p = current_proc();
+	t.pid = proc_getpid(p); t.uid = proc_uniqueid(p);
+	if (t.pid <= 0 || !t.uid) return t;
+	t.enabled = 1; t.address = (uintptr_t)vp; t.vid = vnode_vid(vp); t.base = base;
+	t.stamp = native_blob_now();
+	return t;
+}
+static void
+native_blob_mark(struct native_blob_timing *t, unsigned phase)
+{
+	if (!t->enabled) return;
+	uint64_t now = native_blob_now();
+	t->ns[t->phase] += now - t->stamp;
+	t->stamp = now; t->phase = phase;
+	if (phase == 2) t->mac_count++;
+}
+static int
+native_blob_finish(struct native_blob_timing *t, int error)
+{
+	if (t->enabled) {
+		native_blob_mark(t, 3);
+		native_root_blob_timing_record(t->pid, t->uid, t->address, t->vid, t->base, t->ns, t->mac_count, error);
+	}
+	return error;
+}
+#else
+struct native_blob_timing { int unused; };
+#define native_blob_begin(vp, base) ((struct native_blob_timing){0})
+#define native_blob_mark(t, phase) ((void)(t))
+#define native_blob_finish(t, error) ((void)(t), (error))
+#endif
