+/* Optional signature-case wall time, including final fd cleanup. Counters are
+ * cumulative per process unique ID (first four processes); nested stages must not be summed with
+ * whole_ns. No UART work on the signature path. */
+#if defined(XNU_ROOT_TIMING) && XNU_ROOT_TIMING
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+struct native_sig_slot { int pid; uint64_t uniqueid, count, bytes, whole_ns, errors;
+    uint64_t read_count, read_bytes, read_ns, add_count, add_bytes, add_ns;
+    uint64_t blob_count, blob_errors, init_count, init_ns, pre_ns, mac_count, mac_ns, post_ns;
+    uint64_t vnode_cross, vnode_dropped, duplicate_vnode, duplicate_vid, duplicate_base, duplicate_peer; };
+static struct native_sig_slot native_sig_slots[4];
+static unsigned native_sig_reports;
+struct native_sig_timing { struct native_sig_slot *slot; uint64_t begin, bytes;
+    uint64_t read_count, read_bytes, read_ns, add_count, add_bytes, add_ns; };
+static uint64_t
+native_sig_now(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+static struct native_sig_slot *
+native_sig_slot_get(int pid, uint64_t uniqueid)
+{
+	if (pid <= 0 || uniqueid == 0) return NULL;
+	for (unsigned i = 0; i < 4; i++) {
+		uint64_t expected = 0;
+		if (__atomic_load_n(&native_sig_slots[i].uniqueid, __ATOMIC_RELAXED) == uniqueid ||
+		    __atomic_compare_exchange_n(&native_sig_slots[i].uniqueid, &expected, uniqueid, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED) || expected == uniqueid) {
+			__atomic_store_n(&native_sig_slots[i].pid, pid, __ATOMIC_RELAXED);
+			return &native_sig_slots[i];
+		}
+	}
+	return NULL;
+}
+static void
+native_sig_begin(struct native_sig_timing *t, proc_t p, int cmd)
+{
+	unsigned flag = 0;
+	if (cmd == F_ADDSIGS || !PE_parse_boot_argn("native-root-timing", &flag, sizeof(flag)) || flag != 1) return;
+	t->slot = native_sig_slot_get(proc_getpid(p), proc_uniqueid(p));
+	if (t->slot) t->begin = native_sig_now();
+}
+/* Values only, never retained vnode references. The bounded table is observed
+ * with a nonblocking try-lock after the original blob-add cleanup. Contention
+ * or exhaustion drops only the duplicate sample, never timing counters. */
+struct native_sig_vnode { uintptr_t address; uint32_t vid; int64_t base;
+    uint64_t first_uid, second_uid; unsigned seen; };
+static struct native_sig_vnode native_sig_vnodes[64];
+static unsigned native_sig_vnodes_busy;
+void native_root_blob_timing_record(int, uint64_t, uintptr_t, uint32_t, int64_t,
+    const uint64_t [4], unsigned, int);
+void
+native_root_blob_timing_record(int pid, uint64_t uid, uintptr_t address, uint32_t vid,
+    int64_t base, const uint64_t ns[4], unsigned mac_count, int error)
+{
+	struct native_sig_slot *s = native_sig_slot_get(pid, uid);
+	if (!s) return;
+#define BLOB_ACC(field, n) __atomic_fetch_add(&s->field, (n), __ATOMIC_RELAXED)
+	BLOB_ACC(blob_count, 1); BLOB_ACC(blob_errors, error != 0);
+	BLOB_ACC(init_count, 1); BLOB_ACC(init_ns, ns[0]); BLOB_ACC(pre_ns, ns[1]);
+	BLOB_ACC(mac_count, mac_count); BLOB_ACC(mac_ns, ns[2]); BLOB_ACC(post_ns, ns[3]);
+	unsigned expected = 0;
+	if (!__atomic_compare_exchange_n(&native_sig_vnodes_busy, &expected, 1, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+		BLOB_ACC(vnode_dropped, 1);
+		return;
+	}
+	unsigned bit = 1U << (unsigned)(s - native_sig_slots);
+	unsigned i;
+	for (i = 0; i < 64; i++) {
+		struct native_sig_vnode *v = &native_sig_vnodes[i];
+		if (!v->seen) {
+			v->address = address; v->vid = vid; v->base = base; v->first_uid = uid; v->seen = bit;
+			break;
+		}
+		if (v->address != address || v->vid != vid || v->base != base) continue;
+		if (v->seen & ~bit) {
+			if (uid != v->first_uid && !v->second_uid) v->second_uid = uid;
+			BLOB_ACC(vnode_cross, 1);
+			__atomic_store_n(&s->duplicate_vnode, address, __ATOMIC_RELAXED);
+			__atomic_store_n(&s->duplicate_vid, vid, __ATOMIC_RELAXED);
+			__atomic_store_n(&s->duplicate_base, (uint64_t)base, __ATOMIC_RELAXED);
+			__atomic_store_n(&s->duplicate_peer, uid == v->first_uid ? v->second_uid : v->first_uid, __ATOMIC_RELAXED);
+		}
+		v->seen |= bit;
+		break;
+	}
+	if (i == 64) BLOB_ACC(vnode_dropped, 1);
+	__atomic_store_n(&native_sig_vnodes_busy, 0, __ATOMIC_RELEASE);
+#undef BLOB_ACC
+}
+static uint64_t
+native_sig_stage_begin(const struct native_sig_timing *t)
+{
+	return t->slot ? native_sig_now() : 0;
+}
+static void
+native_sig_stage_end(struct native_sig_timing *t, uint64_t start, uint64_t bytes, int add)
+{
+	if (!t->slot) return;
+	uint64_t elapsed = native_sig_now() - start;
+	if (add) { t->add_count++; t->add_bytes += bytes; t->add_ns += elapsed; }
+	else { t->read_count++; t->read_bytes += bytes; t->read_ns += elapsed; }
+}
+static int
+native_sig_finish(struct native_sig_timing *t, int error)
+{
+	if (!t->slot) return error;
+#define SIG_ACC(field, value) __atomic_fetch_add(&t->slot->field, (value), __ATOMIC_RELAXED)
+	SIG_ACC(whole_ns, native_sig_now() - t->begin);
+	SIG_ACC(bytes, t->bytes);
+	SIG_ACC(errors, error != 0);
+	SIG_ACC(read_count, t->read_count); SIG_ACC(read_bytes, t->read_bytes); SIG_ACC(read_ns, t->read_ns);
+	SIG_ACC(add_count, t->add_count); SIG_ACC(add_bytes, t->add_bytes); SIG_ACC(add_ns, t->add_ns);
+	SIG_ACC(count, 1);
+#undef SIG_ACC
+	return error;
+}
+/* Called only by the gated shared-region begin, at most twice per boot.
+ * Relaxed snapshots can overlap ongoing calls; these are not CPU-exclusive times. */
+void native_root_signature_timing_report(void);
+void
+native_root_signature_timing_report(void)
+{
+	unsigned n = __atomic_load_n(&native_sig_reports, __ATOMIC_RELAXED);
+	do { if (n >= 2) return; }
+	while (!__atomic_compare_exchange_n(&native_sig_reports, &n, n + 1, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+	for (unsigned i = 0; i < 4; i++) {
+		struct native_sig_slot *s = &native_sig_slots[i];
+		int pid = __atomic_load_n(&s->pid, __ATOMIC_RELAXED);
+		if (!pid) continue;
+#define SIG_GET(field) ((unsigned long long)__atomic_load_n(&s->field, __ATOMIC_RELAXED))
+		printf("root signature timing pid=%d uniqueid=%llu count=%llu bytes=%llu whole_ns=%llu errors=%llu read_count=%llu read_requested_bytes=%llu read_ns=%llu add_count=%llu add_bytes=%llu add_ns=%llu blob_count=%llu blob_errors=%llu init_count=%llu init_ns=%llu pre_ns=%llu mac_count=%llu mac_ns=%llu post_ns=%llu vnode_cross=%llu vnode_dropped=%llu duplicate_vnode=%llx duplicate_vid=%llu duplicate_base=%llx duplicate_peer=%llu\n",
+		    pid, SIG_GET(uniqueid), SIG_GET(count), SIG_GET(bytes), SIG_GET(whole_ns), SIG_GET(errors),
+		    SIG_GET(read_count), SIG_GET(read_bytes), SIG_GET(read_ns), SIG_GET(add_count), SIG_GET(add_bytes), SIG_GET(add_ns),
+		    SIG_GET(blob_count), SIG_GET(blob_errors), SIG_GET(init_count), SIG_GET(init_ns), SIG_GET(pre_ns),
+		    SIG_GET(mac_count), SIG_GET(mac_ns), SIG_GET(post_ns), SIG_GET(vnode_cross), SIG_GET(vnode_dropped),
+		    SIG_GET(duplicate_vnode), SIG_GET(duplicate_vid), SIG_GET(duplicate_base), SIG_GET(duplicate_peer));
+#undef SIG_GET
+	}
+}
+#define native_sig_bytes(t, n) ((t)->bytes = (n))
+#else
+struct native_sig_timing { int unused; };
+#define native_sig_begin(t, p, cmd) ((void)(t))
+#define native_sig_stage_begin(t) ((void)(t), 0ULL)
+#define native_sig_stage_end(t, start, bytes, add) ((void)(t), (void)(start))
+#define native_sig_bytes(t, n) ((void)(t))
+#define native_sig_finish(t, error) ((void)(t), (error))
+#endif
