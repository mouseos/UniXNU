+#if defined(XNU_ARMCPU_SWITCH_OBSERVER) && XNU_ARMCPU_SWITCH_OBSERVER
+/* Experimental current-thread snapshot.  Caller must disable preemption;
+ * this neither proves PMU ownership nor excludes interrupts. */
+bool unixnu_current_thread_switches(uint32_t *out);
+bool
+unixnu_current_thread_switches(uint32_t *out)
+{
+	if (out == NULL || get_preemption_level() <= 0) {
+		return false;
+	}
+	thread_t thread = current_thread();
+	if (thread == THREAD_NULL) {
+		return false;
+	}
+	*out = thread->c_switch;
+	return true;
+}
+#endif
 
