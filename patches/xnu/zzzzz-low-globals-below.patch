--- a/osfmk/arm/pmap/pmap.h
+++ b/osfmk/arm/pmap/pmap.h
@@ -238,6 +238,16 @@ typedef struct pmap_cpu_data pmap_cpu_data_t;
 /* Base address for low globals. */
 #if defined(ARM_LARGE_MEMORY)
 #define LOW_GLOBAL_BASE_ADDRESS 0xfffffe0000000000ULL
+#elif defined(XNU_LOW_GLOBALS_BELOW) && XNU_LOW_GLOBALS_BELOW
+/*
+ * Optional (default off): the low globals 512 MiB below their usual place, for boards that hand XNU physical memory far
+ * below the kernel. The static region starts at gVirtBase (the kernel's virtual address minus the memory below it), which
+ * must not reach the low globals' 8 MiB reservation (pmap_virtual_region); this moves that limit from 0xfffffff000800000
+ * to 0xffffffefe0800000. The heap packing base (KERNEL_PMAP_HEAP_RANGE_START) follows it. Debuggers that look for the
+ * low globals at the fixed 0xfffffff000000000 do not find them; the boot loader can read the address from the
+ * __DATA_CONST,__lowglo_base section (lowmem_vectors.c).
+ */
+#define LOW_GLOBAL_BASE_ADDRESS 0xffffffefe0000000ULL
 #else /* defined(ARM_LARGE_MEMORY) */
 #define LOW_GLOBAL_BASE_ADDRESS 0xfffffff000000000ULL
 #endif /* defined(ARM_LARGE_MEMORY) */
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2110,6 +2110,16 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 */
 	va_l1 = va_l2 = LOW_GLOBAL_BASE_ADDRESS;
 	cpu_l1_tte = cpu_tte + ((va_l1 & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
+#if defined(XNU_LOW_GLOBALS_BELOW) && XNU_LOW_GLOBALS_BELOW && !defined(ARM_LARGE_MEMORY)
+	/*
+	 * The moved low globals may lie in an L1 block of their own, below the kernel's: give it an L2 table first.
+	 */
+	if ((*cpu_l1_tte & ARM_TTE_VALID) == 0) {
+		ptpage_vaddr = alloc_ptpage(TRUE);
+		bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+		*cpu_l1_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
+	}
+#endif
 	cpu_l2_tte = ((tt_entry_t *) phystokv(((*cpu_l1_tte) & ARM_TTE_TABLE_MASK))) + ((va_l2 & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
 	ptpage_vaddr = alloc_ptpage(TRUE);
 	*cpu_l2_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
--- a/osfmk/arm64/lowmem_vectors.c
+++ b/osfmk/arm64/lowmem_vectors.c
@@ -88,6 +88,18 @@ lowglo lowGlo __attribute__ ((aligned(PAGE_MAX_SIZE))) = {
 	.lgCompressorSizeAddr   = (uint64_t) &c_buffers_size // added in 3.3
 };
 
+#if defined(XNU_LOW_GLOBALS_BELOW) && XNU_LOW_GLOBALS_BELOW
+#include <arm/pmap.h>
+
+/*
+ * Where the low globals are mapped (LOW_GLOBAL_BASE_ADDRESS, moved by XNU_LOW_GLOBALS_BELOW), for the boot loader: it
+ * must keep the kernel's static region (gVirtBase, rounded down to the L2 block) above them and their reservation.
+ * Read from the Mach-O before the kernel runs; nothing reads it at run time.
+ */
+__attribute__((used, section("__DATA_CONST,__lowglo_base")))
+const uint64_t lowglo_base_address = LOW_GLOBAL_BASE_ADDRESS;
+#endif
+
 void
 patch_low_glo(void)
 {
