diff --git a/osfmk/arm64/unixnu_systrace.h b/osfmk/arm64/unixnu_systrace.h
new file mode 100644
index 0000000..1f95de0
--- /dev/null
+++ b/osfmk/arm64/unixnu_systrace.h
@@ -0,0 +1,32 @@
+/*
+ * Opt-in per-process syscall profile (build: XNU_SYSCALL_TRACE=1, runtime:
+ * boot-arg unixnu-systrace-pid). Implemented in osfmk/arm64/bsd_arm64.c.
+ */
+#ifndef _ARM64_UNIXNU_SYSTRACE_H_
+#define _ARM64_UNIXNU_SYSTRACE_H_
+
+#if defined(XNU_SYSCALL_TRACE) && XNU_SYSCALL_TRACE
+#include <stdint.h>
+#include <stdbool.h>
+
+struct arm_saved_state;
+
+/* BSD syscalls use slots [0, 600); Mach trap n uses slot 600 + n. */
+#define UNIXNU_SYSTRACE_BSD_SLOTS 600u
+
+extern int32_t unixnu_st_pid;
+
+/* Cheap gate checked before any per-call work; false unless the boot-arg is set. */
+static inline bool
+unixnu_systrace_on(void)
+{
+	return __builtin_expect(unixnu_st_pid >= 0, 0);
+}
+
+extern bool unixnu_systrace_wants(int pid);
+extern void unixnu_systrace_enter(unsigned int slot);
+extern void unixnu_systrace_note(unsigned int slot, int err, uint64_t ret, const uint64_t *args,
+    int path_arg, struct arm_saved_state *state, uint64_t start_abs);
+#endif /* XNU_SYSCALL_TRACE */
+
+#endif /* _ARM64_UNIXNU_SYSTRACE_H_ */
