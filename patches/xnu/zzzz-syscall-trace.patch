+static int
+unixnu_systrace_path_arg(unsigned int code)
+{
+	switch (code) {
+	case SYS_open: case SYS_open_nocancel: case SYS_access: case SYS_stat: case SYS_lstat:
+	case SYS_stat64: case SYS_lstat64: case SYS_readlink: case SYS_getattrlist: case SYS_execve:
+	case SYS_unlink: case SYS_mkdir: case SYS_rename: case SYS_chdir: case SYS_statfs64: case SYS_chmod:
+	case SYS_open_dprotected_np: case SYS_guarded_open_np: case SYS_guarded_open_dprotected_np:
+		return 0;
+	case SYS_openat: case SYS_openat_nocancel: case SYS_fstatat: case SYS_fstatat64:
+	case SYS_faccessat: case SYS_posix_spawn: case SYS_getattrlistat:
+		return 1;
+	default:
+		return -1;
+	}
+}
+#endif
