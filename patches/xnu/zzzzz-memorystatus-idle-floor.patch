+/*
+ * UniXNU opt-in (boot argument msidle=<process name>:<MB>): the named process never gets an inactive (idle)
+ * per-process memory limit below <MB>; its active limit is left alone, so crossing that one still reports.
+ * A limit of -1 or 0 (system-wide limit, or none) is left alone. For telling whether a daemon is killed when it
+ * goes idle for a footprint it needs; without the argument nothing changes.
+ */
+static int memorystatus_unixnu_idle_state; /* 0 unread, 1 none, 2 set */
+static char memorystatus_unixnu_idle_name[2 * MAXCOMLEN + 1];
+static int32_t memorystatus_unixnu_idle_mb;
+
+static void
+memorystatus_unixnu_idle_read(void)
+{
+	char arg[2 * MAXCOMLEN + 16] = "";
+	size_t colon = 0;
+	int32_t mb = 0;
+
+	if (memorystatus_unixnu_idle_state != 0) {
+		return;
+	}
+	memorystatus_unixnu_idle_state = 1;
+	if (!PE_parse_boot_arg_str("msidle", arg, sizeof(arg))) {
+		return;
+	}
+	arg[sizeof(arg) - 1] = '\0';
+	while (arg[colon] && arg[colon] != ':') {
+		colon++;
+	}
+	if (arg[colon] != ':' || colon == 0 || colon > 2 * MAXCOMLEN) {
+		return;
+	}
+	for (size_t i = colon + 1; arg[i] >= '0' && arg[i] <= '9' && mb < 100000; i++) {
+		mb = mb * 10 + (arg[i] - '0');
+	}
+	if (mb <= 0) {
+		return;
+	}
+	memcpy(memorystatus_unixnu_idle_name, arg, colon);
+	memorystatus_unixnu_idle_name[colon] = '\0';
+	memorystatus_unixnu_idle_mb = mb;
+	memorystatus_unixnu_idle_state = 2;
+}
+
+/* Also used by task.c to print what the footprint is made of when this process crosses a limit. */
+bool memorystatus_unixnu_idle_match(const char *name);
+bool
+memorystatus_unixnu_idle_match(const char *name)
+{
+	memorystatus_unixnu_idle_read();
+	return memorystatus_unixnu_idle_state == 2 && name &&
+	       strncmp(name, memorystatus_unixnu_idle_name, sizeof(memorystatus_unixnu_idle_name)) == 0;
+}
+
+static int32_t
+memorystatus_unixnu_idle_floor(proc_t p, int32_t limit)
+{
+	if (limit <= 0 || !memorystatus_unixnu_idle_match(p->p_name) || limit >= memorystatus_unixnu_idle_mb) {
+		return limit;
+	}
+	printf("unixnu msidle pid=%d name=%s inactive limit %dMB raised to %dMB\n", proc_getpid(p), p->p_name, limit,
+	    memorystatus_unixnu_idle_mb);
+	return memorystatus_unixnu_idle_mb;
+}
